# Job Scout - environment configuration.
# Copy to `.env` and fill in. The app runs with NO keys at all (Remotive +
# cached dataset); add keys for real ranking, live jobs and tracing.
#
# Put values directly after `=` with nothing else on the line. Do not add
# inline `# comments` after a value: some dotenv parsers read the comment as
# the value when the key is empty.

# --- LLM via OpenRouter (required for a real run) ----------------------------
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# An OpenRouter model id, e.g. openai/gpt-4o-mini. Phase 1 picks the real default.
SCOUT_MODEL=openai/gpt-4o-mini
# Optional (Phase 4). Defaults to the same as SCOUT_MODEL.
SCOUT_TAILOR_MODEL=openai/gpt-4o-mini

# --- Opik observability: choose ONE mode -------------------------------------
OPIK_ENABLED=true
# local = self-hosted Opik (see deploy/opik/README.md); cloud = Opik Cloud free tier
OPIK_MODE=local
# local mode: API URL of your Opik server, e.g. http://hermes:5173/api
OPIK_URL_OVERRIDE=
# cloud mode only (https://www.comet.com/):
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=job-scout
# Attach the CV PDF to traces. Keep false for real CVs on shared servers.
TRACE_ATTACH_CV=false

# --- Job sources (all optional) ----------------------------------------------
# JSearch: Google-for-Jobs aggregator (OpenWeb Ninja), free tier ~200 req/month.
JSEARCH_API_KEY=
# Adzuna: free registration at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Guardrails --------------------------------------------------------------
MAX_LLM_CALLS_PER_RUN=25

# --- Scheduled scan and notifications (`job-scout run`) ----------------------
# Path to your CV (keep it under the git-ignored private/ folder).
SCOUT_CV_PATH=private/cv.pdf
SCOUT_DB_PATH=private/scout.db
# Only NEW jobs scoring at least this are sent.
NOTIFY_MIN_SCORE=70
# Telegram: bot token from @BotFather, and the chat id to message. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional forum topic id.
TELEGRAM_THREAD_ID=
# Email via SMTP. Gmail: enable 2-step verification, then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
